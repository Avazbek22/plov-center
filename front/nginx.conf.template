server {
    listen      ${NGINX_PORT};
    server_name _;
    server_tokens off;

    root  /usr/share/nginx/html;
    index index.html;

    # Allow image uploads from the admin panel (multipart form-data)
    client_max_body_size 25m;

    # Long-cache built SPA assets (Vite emits content-hashed filenames)
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # JSON API → backend
    location /api/ {
        proxy_pass                         ${BACKEND_URL};
        proxy_http_version                 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout                 60s;
    }

    # User-uploaded images served by backend static files
    location /uploads/ {
        proxy_pass                         ${BACKEND_URL};
        proxy_http_version                 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    }

    # SPA history fallback — everything else returns index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip            on;
    gzip_vary       on;
    gzip_min_length 1024;
    gzip_types      text/plain text/css application/javascript application/json image/svg+xml;
}
